{
    servers {
        timeouts {
            read_header 10s
            read_body 15s
            # Must exceed the router's 240 s request deadline plus its 10 s admission margin,
            # otherwise long non-stream generations and streams are cut while still billed.
            write 290s
            idle 2m
        }
        max_header_size 16KiB
    }
}
{$DOMAIN} {
    request_body {
        max_size 16MB
    }
    reverse_proxy router:8788 {
        flush_interval -1
        transport http {
            # A non-stream response sends no bytes until generation (and any repair) completes.
            read_timeout 260s
            write_timeout 135s
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
