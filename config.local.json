{
  "bind": "127.0.0.1:8788",
  "database": "data/router.db",
  "catalog": "data/catalog.json",
  "data_collection": "deny",
  "zdr": false,
  "daily_estimated_budget_usd": 10,
  "max_request_estimated_usd": 1,
  "tenant_concurrent": 4,
  "requests_per_minute": 60,
  "max_concurrent": 32,
  "request_timeout_secs": 240,
  "catalog_max_age_secs": 3600,
  "fallback_model": "anthropic/claude-sonnet-5.5",
  "repair_model": "google/gemini-3.8-flash",
  "output_recovery_model": "openai/gpt-5.4",
  "allow_provider_fallbacks": true,
  "max_generation_failovers": 2,
  "verify_text_answers": true,
  "model_answer_review": false,
  "jev_model": "typesafe/jev-1.13",
  "advisor_model": null,
  "hard_allowed_models": [
    "openai/*",
    "anthropic/*",
    "google/gemini-*",
    "x-ai/*",
    "deepseek/*",
    "qwen/*"
  ],
  "hard_excluded_models": [
    "openai/gpt-oss*",
    "qwen/qwen-*",
    "qwen/qwen2*",
    "qwen/qwq*",
    "deepseek/deepseek-r1*",
    "deepseek/deepseek-chat*",
    "deepseek/deepseek-v3*",
    "deepseek/deepseek-prover*"
  ],
  "pool_tiers": {
    "cheap": [
      "google/gemini-*-flash-lite*",
      "openai/gpt-5*-nano",
      "qwen/qwen3*-flash*",
      "x-ai/grok-*-fast*"
    ],
    "medium": [
      "google/gemini-*-flash",
      "openai/gpt-5.[0-9]-mini",
      "anthropic/claude-haiku-*",
      "deepseek/deepseek-v*-flash*",
      "qwen/qwen3*-plus*"
    ],
    "hard": [
      "anthropic/claude-sonnet-*",
      "openai/gpt-5.[0-9]",
      "google/gemini-*-pro-preview",
      "anthropic/claude-opus-*",
      "x-ai/grok-4*",
      "qwen/qwen3*-max*",
      "google/gemini-*-pro"
    ]
  },
  "pool_per_tier": 6,
  "max_model_age_days": 365
}
